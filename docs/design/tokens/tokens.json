{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Brew & Co design tokens (W3C DTCG format). tokens.css is the Tailwind v4 rendering of this file; keep the two in sync.",
  "color": {
    "ink": { "$type": "color", "$value": "#000000", "$description": "Headings, primary buttons, icons." },
    "brand": {
      "50": { "$type": "color", "$value": "#fff4eb" },
      "100": { "$type": "color", "$value": "#ffe4cf" },
      "200": { "$type": "color", "$value": "#ffd5ad", "$description": "Icon tile fill." },
      "300": { "$type": "color", "$value": "#ffb27a" },
      "400": { "$type": "color", "$value": "#ff8a3d" },
      "500": { "$type": "color", "$value": "#fe6802", "$description": "Brew orange. Rails, arcs, prices, kicker lines, accent buttons." },
      "600": { "$type": "color", "$value": "#e05a00", "$description": "Accent button hover." },
      "700": { "$type": "color", "$value": "#b84a00", "$description": "Orange text that must pass AA on white." },
      "800": { "$type": "color", "$value": "#8a3700" }
    },
    "surface": {
      "paper": { "$type": "color", "$value": "#ffffff", "$description": "Page background." },
      "mist": { "$type": "color", "$value": "#fafafa", "$description": "Footer, stat ring fill, quiet panels." },
      "fog": { "$type": "color", "$value": "#f2f2f2", "$description": "Feature pill bars, image wells." }
    },
    "line": {
      "default": { "$type": "color", "$value": "#e6e6e6", "$description": "Card hairlines." },
      "strong": { "$type": "color", "$value": "#c2c2c2", "$description": "Inputs." },
      "ink": { "$type": "color", "$value": "#363636", "$description": "Outline buttons." }
    },
    "text": {
      "default": { "$type": "color", "$value": "#000000" },
      "body": { "$type": "color", "$value": "#5c5c5c" },
      "muted": { "$type": "color", "$value": "#8a8a8a" },
      "placeholder": { "$type": "color", "$value": "#a3a3a3" },
      "on-ink": { "$type": "color", "$value": "#ffffff" },
      "on-brand": { "$type": "color", "$value": "#ffffff" }
    },
    "feedback": {
      "success": { "$type": "color", "$value": "#1f7a3a" },
      "danger": { "$type": "color", "$value": "#c62828" }
    }
  },
  "font": {
    "family": {
      "display": { "$type": "fontFamily", "$value": ["Comfortaa", "ui-rounded", "system-ui", "sans-serif"], "$description": "Variable 300–700. Hero word at 300, headings and stats at 700." },
      "sans": { "$type": "fontFamily", "$value": ["Raleway", "system-ui", "sans-serif"], "$description": "Variable 100–900. Body 400, UI labels 500, buttons 600–700. Always with lining numerals (lnum)." }
    },
    "weight": {
      "hero": { "$type": "fontWeight", "$value": 300 },
      "body": { "$type": "fontWeight", "$value": 400 },
      "label": { "$type": "fontWeight", "$value": 500 },
      "button": { "$type": "fontWeight", "$value": 600 },
      "heading": { "$type": "fontWeight", "$value": 700 }
    },
    "size": {
      "xs": { "$type": "dimension", "$value": "0.75rem" },
      "sm": { "$type": "dimension", "$value": "0.875rem" },
      "base": { "$type": "dimension", "$value": "1rem" },
      "lg": { "$type": "dimension", "$value": "1.125rem" },
      "xl": { "$type": "dimension", "$value": "1.375rem" },
      "2xl": { "$type": "dimension", "$value": "1.75rem" },
      "3xl": { "$type": "dimension", "$value": "2.25rem" },
      "4xl": { "$type": "dimension", "$value": "3rem" },
      "5xl": { "$type": "dimension", "$value": "4rem" },
      "6xl": { "$type": "dimension", "$value": "5.5rem" },
      "display": { "$type": "dimension", "$value": "clamp(4.5rem, 15vw, 13.5rem)" },
      "stat": { "$type": "dimension", "$value": "clamp(2.5rem, 5vw, 3.75rem)" }
    },
    "lineHeight": {
      "display": { "$type": "number", "$value": 0.92 },
      "heading": { "$type": "number", "$value": 1.1 },
      "body": { "$type": "number", "$value": 1.7 },
      "tight": { "$type": "number", "$value": 1 }
    },
    "letterSpacing": {
      "display": { "$type": "dimension", "$value": "-0.02em" },
      "heading": { "$type": "dimension", "$value": "-0.01em" }
    }
  },
  "space": {
    "$description": "Base unit 4px (Tailwind --spacing). Named steps are the ones the layout actually uses.",
    "1": { "$type": "dimension", "$value": "0.25rem" },
    "2": { "$type": "dimension", "$value": "0.5rem" },
    "3": { "$type": "dimension", "$value": "0.75rem" },
    "4": { "$type": "dimension", "$value": "1rem" },
    "6": { "$type": "dimension", "$value": "1.5rem" },
    "8": { "$type": "dimension", "$value": "2rem" },
    "12": { "$type": "dimension", "$value": "3rem" },
    "16": { "$type": "dimension", "$value": "4rem" },
    "24": { "$type": "dimension", "$value": "6rem" },
    "section-sm": { "$type": "dimension", "$value": "4rem", "$description": "Section padding on mobile." },
    "section-lg": { "$type": "dimension", "$value": "6rem", "$description": "Section padding from md breakpoint." },
    "gutter": { "$type": "dimension", "$value": "1.5rem", "$description": "Side gutter, 1rem on the smallest screens." }
  },
  "size": {
    "container": {
      "page": { "$type": "dimension", "$value": "75rem" },
      "prose": { "$type": "dimension", "$value": "40rem" }
    },
    "control": {
      "sm": { "$type": "dimension", "$value": "2.5rem" },
      "md": { "$type": "dimension", "$value": "3rem" },
      "lg": { "$type": "dimension", "$value": "3.5rem" }
    },
    "stat-ring": { "$type": "dimension", "$value": "clamp(11rem, 18vw, 15rem)" },
    "icon-tile": { "$type": "dimension", "$value": "2.75rem" }
  },
  "radius": {
    "none": { "$type": "dimension", "$value": "0px", "$description": "Primary buttons." },
    "control": { "$type": "dimension", "$value": "0.375rem" },
    "tile": { "$type": "dimension", "$value": "0.75rem" },
    "card": { "$type": "dimension", "$value": "1.25rem" },
    "rail": { "$type": "dimension", "$value": "1.5rem" },
    "pill": { "$type": "dimension", "$value": "9999px" }
  },
  "stroke": {
    "rail": { "$type": "dimension", "$value": "2px" },
    "arc": { "$type": "dimension", "$value": "6px" }
  },
  "shadow": {
    "card": {
      "$type": "shadow",
      "$value": [
        { "color": "rgba(0,0,0,0.03)", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px" },
        { "color": "rgba(254,104,2,0.22)", "offsetX": "0px", "offsetY": "24px", "blur": "48px", "spread": "-28px" }
      ]
    },
    "pill": {
      "$type": "shadow",
      "$value": { "color": "rgba(0,0,0,0.18)", "offsetX": "0px", "offsetY": "6px", "blur": "16px", "spread": "-10px" }
    },
    "glow": {
      "$type": "shadow",
      "$value": { "color": "rgba(254,104,2,0.32)", "offsetX": "0px", "offsetY": "0px", "blur": "140px", "spread": "60px" }
    }
  },
  "motion": {
    "easing": { "brand": { "$type": "cubicBezier", "$value": [0.2, 0.8, 0.2, 1] } },
    "duration": {
      "press": { "$type": "duration", "$value": "120ms" },
      "hover": { "$type": "duration", "$value": "180ms" },
      "reveal": { "$type": "duration", "$value": "700ms" },
      "glow": { "$type": "duration", "$value": "900ms" }
    }
  },
  "breakpoint": {
    "$description": "Tailwind defaults; listed for designers.",
    "sm": { "$type": "dimension", "$value": "40rem" },
    "md": { "$type": "dimension", "$value": "48rem" },
    "lg": { "$type": "dimension", "$value": "64rem" },
    "xl": { "$type": "dimension", "$value": "80rem" }
  }
}
